// KaamConnect domain schema (Prisma ORM 7.10). Design rationale: docs/02-database.md.
// The datasource URL lives in prisma.config.ts (Prisma 7).
// Raw-SQL constraints Prisma cannot express (CHECKs, partial unique indexes, sequence start)
// are hand-written at the end of prisma/migrations/*_baseline/migration.sql; keep them there.
//
// Conventions: snake_case tables/columns via @map/@@map, UUIDv7 primary keys for
// transactional data, Int PKs for small reference tables, money in whole INR (Int),
// timestamps are timestamptz (UTC).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Language {
  en
  hi
  pa
}

enum OtpChannel {
  SMS
  WHATSAPP
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentType {
  AADHAAR_FRONT
  AADHAAR_BACK
}

enum JobTiming {
  IMMEDIATE // "Immediate (30m)"
  AFTERNOON
  TOMORROW
  SCHEDULED // exact future date and time (scheduled_for is required)
}

// A worker's answer to a lead that reached them (lead acceptance is separate from quoting and from booking).
enum LeadResponse {
  ACCEPTED
  DECLINED
}

enum JobStatus {
  OPEN // broadcast, receiving offers
  ASSIGNED // offer accepted, worker en route
  ARRIVED // arrival code verified
  IN_PROGRESS // bill approved by customer, work under way
  WORK_COMPLETED // ready for direct settlement
  COMPLETED // payment recorded
  CANCELLED
}

enum CancelledBy {
  CUSTOMER
  WORKER
  SYSTEM
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED // another offer was accepted
  WITHDRAWN
}

enum JobMediaKind {
  PROBLEM_PHOTO
  VOICE_NOTE
  BEFORE_PHOTO
  AFTER_PHOTO
}

enum BillItemKind {
  VISIT_FEE
  PARTS
  LABOUR
  OTHER
}

enum PaymentMethod {
  UPI
  CASH
}

enum PaymentStatus {
  MARKED_PAID // customer tapped "Paid"
  CONFIRMED // worker confirmed receipt (optional; no UI yet)
}

enum ReviewTag {
  PUNCTUAL
  FAIR_PRICE
  CLEAN_WORK
  POLITE
  EXPERT_SKILL
}

enum JobSecurityEventType {
  ARRIVAL_LOCKED // five wrong arrival codes; actor = the worker
  ARRIVAL_CODE_RESET // the customer issued a new code; actor = the customer
  ARRIVAL_RESET_REFUSED // a reset was refused (detail LIMIT or COOLDOWN); actor = the customer
}

enum SosStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum NotificationType {
  NEW_LEAD // a job worth quoting on appeared near the worker
  DIRECT_REQUEST // a customer asked this worker personally
  NEW_QUOTE // a worker quoted the customer's request
  BOOKING_CONFIRMED // the customer chose the worker; the window is reserved
  WORKER_EN_ROUTE // the worker is on the way
  WORKER_ARRIVED // the arrival code was verified
  BILL_CREATED // the worker itemised the bill; waiting for approval
  WORK_COMPLETED // work is done; ready for payment
  JOB_CANCELLED_BY_CUSTOMER // the customer cancelled a job the worker was given
  JOB_CANCELLED_BY_WORKER // the assigned worker cancelled: the request is open again, or (data.reopened false) closed
  DIRECT_DECLINED // the worker a customer asked for personally said no
  DIRECT_EXPIRED // the worker a customer asked for personally never answered in time
}

// ───────────────────────── Identity & auth ─────────────────────────

model User {
  id                  String    @id @default(uuid(7)) @db.Uuid
  phone               String    @unique @db.VarChar(15) // E.164, e.g. +919876543210
  language            Language  @default(en)
  isAdmin             Boolean   @default(false) @map("is_admin") // ASSUMPTION A-7: minimal worker-verification admin
  isActive            Boolean   @default(true) @map("is_active")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3) // set once the account has been anonymised (docs/08 s1); never cleared
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz(3) // a disabled person asked for deletion; waits for an admin
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer        CustomerProfile?
  worker          WorkerProfile?     @relation("WorkerUser")
  reviewedWorkers WorkerProfile[]    @relation("WorkerReviewer")
  refreshTokens   RefreshToken[]
  sosAlerts       SosAlert[]         @relation("SosRaiser")
  acknowledgedSos SosAlert[]         @relation("SosAcknowledger")
  resolvedSos     SosAlert[]         @relation("SosResolver")
  securityEvents  JobSecurityEvent[]
  jobCancellations JobCancellation[]
  deviceTokens    DeviceToken[]
  notifications   InAppNotification[]

  // Hand-written in the account_deletion_and_sos_delivery migration (Prisma cannot express it), keep it there:
  //  - users_deletion_requested_idx: (deletion_requested_at) WHERE deletion_requested_at IS NOT NULL AND deleted_at IS NULL
  @@map("users")
}

// FCM registration token of one installed app. A token belongs to one user at a time: signing in on the same
// device as someone else moves it. Rows are deleted when FCM reports the token dead.
model DeviceToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  token     String         @unique @db.VarChar(4096)
  platform  DevicePlatform
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("device_tokens")
}

// The bell-icon inbox. Written for every push, whether or not any device could be reached.
model InAppNotification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(120)
  body      String           @db.VarChar(300)
  data      Json             @default("{}")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("in_app_notifications")
}

model OtpChallenge {
  id         String     @id @default(uuid(7)) @db.Uuid
  phone      String     @db.VarChar(15)
  codeHash   String     @map("code_hash") // HMAC-SHA256(code, pepper); never the plain code
  channel    OtpChannel @default(SMS)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid // rotation family, for reuse detection
  tokenHash String    @unique @map("token_hash") // SHA-256 of the opaque token
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ───────────────────────── Reference data ─────────────────────────

model City {
  id    Int    @id @default(autoincrement())
  name  String @unique // Chandigarh | Mohali (SAS Nagar) | Panchkula
  areas Area[]

  @@map("cities")
}

model Area {
  id     Int    @id @default(autoincrement())
  cityId Int    @map("city_id")
  name   String // "Sector 22", "Phase 7", "MDC Sector 4"
  lat    Float? // centroid, used for distance when no GPS fix exists
  lng    Float?

  city          City            @relation(fields: [cityId], references: [id])
  addresses     Address[]
  jobs          Job[]
  workerProfile WorkerProfile[]

  @@unique([cityId, name])
  @@map("areas")
}

// Stable string key kept from the frontend (electrician, plumber, ac_repair, ...). Never renamed.
model ServiceCategory {
  id                 String  @id
  titleEn            String  @map("title_en")
  titleHi            String  @map("title_hi")
  titlePa            String  @map("title_pa")
  iconKey            String  @map("icon_key") // lucide icon name used by the app
  color              String  @db.VarChar(7)
  bgColor            String  @map("bg_color") @db.VarChar(7)
  baseVisitFee       Int     @map("base_visit_fee") // INR, shown as "₹200 visit"
  defaultDurationMin Int?    @map("default_duration_min") // CHECK BETWEEN 15 AND 480; null = BOOKING_DEFAULT_DURATION_MIN (decision D-14)
  examples           String
  sortOrder          Int     @default(0) @map("sort_order")
  isActive           Boolean @default(true) @map("is_active")

  workers WorkerTrade[]
  jobs    Job[]

  @@map("service_categories")
}

// ───────────────────────── Customer ─────────────────────────

model CustomerProfile {
  userId           String   @id @map("user_id") @db.Uuid
  fullName         String   @map("full_name") @db.VarChar(80)
  photoKey         String?  @map("photo_key") // object-storage key
  commLanguage     Language @default(hi) @map("comm_language") // "Preferred language with workers"
  allowDirectCalls Boolean  @default(true) @map("allow_direct_calls")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses Address[]
  jobs      Job[]
  reviews   Review[]

  @@map("customer_profiles")
}

model Address {
  id           String   @id @default(uuid(7)) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  areaId       Int      @map("area_id")
  line         String   @db.VarChar(200) // "House #1402, Near Subhash Park" - private until a worker is assigned
  localityName String?  @map("locality_name") @db.VarChar(80) // typed by the person when their pocket is not in the list ("Sector 82 JLPL"); area_id is then the city's "Other area"
  lat          Float?
  lng          Float?
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer CustomerProfile @relation(fields: [customerId], references: [userId], onDelete: Cascade)
  area     Area            @relation(fields: [areaId], references: [id])

  @@index([customerId])
  @@map("addresses")
}

// ───────────────────────── Worker ─────────────────────────

model WorkerProfile {
  userId             String             @id @map("user_id") @db.Uuid
  fullName           String             @map("full_name") @db.VarChar(80)
  photoKey           String?            @map("photo_key")
  baseAreaId         Int                @map("base_area_id")
  radiusKm           Int                @default(6) @map("radius_km") // CHECK IN (3,6,12)
  scheduledRadiusKm  Int?               @map("scheduled_radius_km") // CHECK IN (3,6,12,25,50): how far the worker will travel for future jobs; null = same as radius_km. Matching uses max(radius_km, this)
  experienceYears    Int                @map("experience_years") // CHECK BETWEEN 1 AND 40
  languages          Language[]
  skills             String[]
  visitingFee        Int?               @map("visiting_fee") // OPEN Q-6: default fee shown on discovery cards
  vehicle            String?            @db.VarChar(80) // shown on tracking screen; not collected in UI yet
  upiId              String?            @map("upi_id") @db.VarChar(80) // needed for the pay-by-UPI QR; not collected in UI yet
  addressLine        String?            @map("address_line") @db.VarChar(200) // shop / workshop / home address; private (shown to the worker and admins only)
  localityName       String?            @map("locality_name") @db.VarChar(80) // typed locality when the base area is not in the list
  isAvailable        Boolean            @default(true) @map("is_available") // "taking jobs" switch: off = no new-lead notifications, hidden from discovery, no direct bookings
  badge              String?            @db.VarChar(60) // admin-assigned label e.g. "Govt Certified Pro"
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(3)
  reviewedAt         DateTime?          @map("reviewed_at") @db.Timestamptz(3) // when an admin (or the dev auto-approval) last decided VERIFIED or REJECTED; null = pending or unknown. D-9 counts retention from here
  reviewedById       String?            @map("reviewed_by") @db.Uuid // the admin who decided; null for the dev auto-approval and for decisions made before this column existed (never guessed)
  rejectionReason    String?            @map("rejection_reason")
  termsAcceptedAt    DateTime           @map("terms_accepted_at") @db.Timestamptz(3)
  ratingSum          Int                @default(0) @map("rating_sum") // avg = ratingSum / reviewCount
  reviewCount        Int                @default(0) @map("review_count")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User             @relation("WorkerUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?            @relation("WorkerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  baseArea   Area             @relation(fields: [baseAreaId], references: [id])
  trades     WorkerTrade[]
  documents  WorkerDocument[]
  location   WorkerLocation?
  offers     Offer[]
  jobs       Job[]            @relation("JobAssignedWorker")
  directJobs Job[]            @relation("JobTargetWorker")
  reviews    Review[]
  leads      WorkerLead[]

  @@index([baseAreaId, verificationStatus])
  @@map("worker_profiles")
}

model WorkerTrade {
  workerId   String  @map("worker_id") @db.Uuid
  categoryId String  @map("category_id")
  isPrimary  Boolean @default(false) @map("is_primary") // max 2 trades per worker (service rule)

  worker   WorkerProfile   @relation(fields: [workerId], references: [userId], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id])

  @@id([workerId, categoryId])
  @@index([categoryId])
  @@map("worker_trades")
}

model WorkerDocument {
  id         String       @id @default(uuid(7)) @db.Uuid
  workerId   String       @map("worker_id") @db.Uuid
  type       DocumentType
  storageKey String       @map("storage_key") // private, encrypted bucket; never returned by public APIs
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  worker WorkerProfile @relation(fields: [workerId], references: [userId], onDelete: Cascade)

  @@unique([workerId, type])
  @@map("worker_documents")
}

// Latest GPS fix only (one row per worker); no route history in the UI.
model WorkerLocation {
  workerId  String   @id @map("worker_id") @db.Uuid
  lat       Float
  lng       Float
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  worker WorkerProfile @relation(fields: [workerId], references: [userId], onDelete: Cascade)

  @@map("worker_locations")
}

// ───────────────────────── Jobs ─────────────────────────

model Job {
  id                 String       @id @default(uuid(7)) @db.Uuid
  jobNumber          Int          @unique @default(autoincrement()) @map("job_number") // shown as KC-<n>; sequence starts at 10000
  customerId         String       @map("customer_id") @db.Uuid
  categoryId         String       @map("category_id")
  title              String       @db.VarChar(120)
  description        String?      @db.VarChar(1000)
  timing             JobTiming
  scheduledFor       DateTime?    @map("scheduled_for") @db.Timestamptz(3) // requested appointment start; null = as soon as possible
  durationMin        Int          @default(90) @map("duration_min") // CHECK BETWEEN 15 AND 480; length of the booking window
  bookedStartAt      DateTime?    @map("booked_start_at") @db.Timestamptz(3) // the worker's reserved window, set when the booking is confirmed
  bookedEndAt        DateTime?    @map("booked_end_at") @db.Timestamptz(3)
  bookingConfirmedAt DateTime?    @map("booking_confirmed_at") @db.Timestamptz(3)
  areaId             Int          @map("area_id")
  addressLine        String       @map("address_line") @db.VarChar(200) // snapshot; revealed only to the assigned worker
  localityName       String?      @map("locality_name") @db.VarChar(80) // snapshot of the address's typed locality; public like the area
  lat                Float?
  lng                Float?
  status             JobStatus    @default(OPEN)
  targetWorkerId     String?      @map("target_worker_id") @db.Uuid // set => direct booking (Home "Book Pro"); only this worker sees it and must accept (Q-3)
  workerId           String?      @map("worker_id") @db.Uuid
  acceptedOfferId    String?      @unique @map("accepted_offer_id") @db.Uuid
  arrivalCode        String?      @map("arrival_code") @db.VarChar(4)
  arrivalAttempts    Int          @default(0) @map("arrival_attempts")
  arrivalCodeResets  Int          @default(0) @map("arrival_code_resets") // customer resets used for this assignment; CHECK >= 0, capped in code (MAX_ARRIVAL_CODE_RESETS)
  arrivalCodeResetAt DateTime?    @map("arrival_code_reset_at") @db.Timestamptz(3) // last reset, for the cooldown
  expiresAt          DateTime?    @map("expires_at") @db.Timestamptz(3) // OPEN jobs auto-cancel (ASSUMPTION A-9)
  assignedAt         DateTime?    @map("assigned_at") @db.Timestamptz(3)
  arrivedAt          DateTime?    @map("arrived_at") @db.Timestamptz(3)
  costApprovedAt     DateTime?    @map("cost_approved_at") @db.Timestamptz(3)
  workCompletedAt    DateTime?    @map("work_completed_at") @db.Timestamptz(3)
  completedAt        DateTime?    @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy        CancelledBy? @map("cancelled_by")
  cancelReason       String?      @map("cancel_reason") @db.VarChar(300)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer       CustomerProfile    @relation(fields: [customerId], references: [userId])
  worker         WorkerProfile?     @relation("JobAssignedWorker", fields: [workerId], references: [userId])
  targetWorker   WorkerProfile?     @relation("JobTargetWorker", fields: [targetWorkerId], references: [userId])
  category       ServiceCategory    @relation(fields: [categoryId], references: [id])
  area           Area               @relation(fields: [areaId], references: [id])
  acceptedOffer  Offer?             @relation("JobAcceptedOffer", fields: [acceptedOfferId], references: [id])
  offers         Offer[]            @relation("JobOffers")
  media          JobMedia[]
  billItems      BillItem[]
  payment        Payment?
  review         Review?
  sosAlerts      SosAlert[]
  workerLeads    WorkerLead[]
  securityEvents JobSecurityEvent[]
  cancellations  JobCancellation[]

  // Hand-written in the scheduling migration (Prisma cannot express them), keep them there:
  //  - jobs_worker_no_overlap: EXCLUDE USING gist (worker_id =, tstzrange(booked_start_at, booked_end_at) &&)
  //    WHERE status IN ('ASSIGNED','ARRIVED','IN_PROGRESS')  => one worker, no overlapping bookings
  //  - jobs_one_in_progress_per_worker: UNIQUE (worker_id) WHERE status IN ('ARRIVED','IN_PROGRESS')
  //  - jobs_worker_booked_idx: (worker_id, booked_start_at) WHERE status IN ('ASSIGNED','ARRIVED','IN_PROGRESS')
  // Hand-written in the arrival_code_reset migration (Prisma cannot express it), keep it there:
  //  - jobs_arrival_code_resets_nonneg: CHECK (arrival_code_resets >= 0). The cap of 3 resets and the 60 s cooldown live in code.
  @@index([status, categoryId, areaId, createdAt]) // worker lead feed
  @@index([customerId, status, createdAt]) // customer "My Jobs" tabs
  @@index([workerId, status, createdAt]) // worker "My Jobs" tabs / earnings
  @@index([targetWorkerId, status]) // direct requests waiting for a worker
  @@index([status, expiresAt]) // expiry sweeper
  @@map("jobs")
}

// One row per (job, worker) lead that reached the worker. Its existence is the "already sent" guard that
// keeps a lead from being pushed twice; `response` records lead acceptance / decline.
model WorkerLead {
  jobId       String        @map("job_id") @db.Uuid
  workerId    String        @map("worker_id") @db.Uuid
  deliveredAt DateTime      @default(now()) @map("delivered_at") @db.Timestamptz(3)
  response    LeadResponse?
  respondedAt DateTime?     @map("responded_at") @db.Timestamptz(3)

  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker WorkerProfile @relation(fields: [workerId], references: [userId], onDelete: Cascade)

  @@id([jobId, workerId])
  @@index([workerId, deliveredAt])
  @@map("worker_leads")
}

// Append-only audit trail of security-relevant things that happen to a job (arrival-code lock and reset).
// It never stores code values. Rows are never updated or deleted by the application.
model JobSecurityEvent {
  id        String               @id @default(uuid(7)) @db.Uuid
  jobId     String               @map("job_id") @db.Uuid
  actorId   String?              @map("actor_id") @db.Uuid
  type      JobSecurityEventType
  detail    String?              @db.VarChar(40) // e.g. LIMIT or COOLDOWN for a refused reset
  ip        String?              @db.VarChar(45)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  job   Job   @relation(fields: [jobId], references: [id])
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
  @@map("job_security_events")
}

/// One row per cancellation by a customer or an assigned worker (docs/13-cancellation.md). `jobs.cancelled_*` only keeps the
/// last outcome, and a worker's back-out on a broadcast job re-opens the job and clears its worker, so this is the only
/// place that remembers who backed out, when, and why. Feeds the worker's cancelled history and the repeat-back-out flag.
model JobCancellation {
  id                   String       @id @default(uuid(7)) @db.Uuid
  jobId                String       @map("job_id") @db.Uuid
  actorId              String?      @map("actor_id") @db.Uuid // who cancelled; kept as NULL if that account is deleted
  actorRole            CancelledBy  @map("actor_role") // CUSTOMER or WORKER (CHECK: never SYSTEM)
  workerId             String?      @map("worker_id") @db.Uuid // the worker the job was assigned to, null when nobody was yet
  stage                JobStatus // where the job was when it was cancelled: OPEN, ASSIGNED or ARRIVED
  reasonCode           String       @map("reason_code") @db.VarChar(40) // see jobs/cancel-reasons.ts
  note                 String?      @db.VarChar(300) // free text the person added; removed when they delete their account
  reopened             Boolean      @default(false) // a broadcast job went back to OPEN for new quotes
  countsAgainstWorker  Boolean      @default(false) @map("counts_against_worker") // a worker-side reason: feeds the repeat back-out warning
  visitFeeDue          Int?         @map("visit_fee_due") // INR, only when the worker had already arrived and it is not their doing
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  job   Job   @relation(fields: [jobId], references: [id])
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
  @@index([workerId, createdAt])
  @@map("job_cancellations")
}

model JobMedia {
  id          String       @id @default(uuid(7)) @db.Uuid
  jobId       String       @map("job_id") @db.Uuid
  kind        JobMediaKind
  storageKey  String       @map("storage_key")
  durationSec Int?         @map("duration_sec") // VOICE_NOTE only
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, kind])
  @@map("job_media")
}

model Offer {
  id         String      @id @default(uuid(7)) @db.Uuid
  jobId      String      @map("job_id") @db.Uuid
  workerId   String      @map("worker_id") @db.Uuid
  visitFee   Int         @map("visit_fee") // INR; CHECK > 0
  etaMinutes Int         @map("eta_minutes") // UI offers 15 / 30 / 45
  message    String?     @db.VarChar(300)
  status     OfferStatus @default(PENDING)
  acceptedAt DateTime?   @map("accepted_at") @db.Timestamptz(3) // when the customer accepted this quote
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  job         Job           @relation("JobOffers", fields: [jobId], references: [id], onDelete: Cascade)
  worker      WorkerProfile @relation(fields: [workerId], references: [userId])
  acceptedFor Job?          @relation("JobAcceptedOffer")

  @@unique([jobId, workerId]) // one quote per worker per job
  @@index([workerId, status])
  @@map("offers")
}

model BillItem {
  id          String       @id @default(uuid(7)) @db.Uuid
  jobId       String       @map("job_id") @db.Uuid
  kind        BillItemKind
  description String       @db.VarChar(120)
  amount      Int // INR; CHECK >= 0
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("bill_items")
}

// Direct P2P settlement: the platform only RECORDS the payment, it never moves money.
model Payment {
  id          String        @id @default(uuid(7)) @db.Uuid
  jobId       String        @unique @map("job_id") @db.Uuid
  method      PaymentMethod
  amount      Int // total at time of marking (sum of bill items); CHECK > 0
  status      PaymentStatus @default(MARKED_PAID)
  markedAt    DateTime      @default(now()) @map("marked_at") @db.Timestamptz(3)
  confirmedAt DateTime?     @map("confirmed_at") @db.Timestamptz(3)

  job Job @relation(fields: [jobId], references: [id])

  @@index([markedAt])
  @@map("payments")
}

model Review {
  id         String      @id @default(uuid(7)) @db.Uuid
  jobId      String      @unique @map("job_id") @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  workerId   String      @map("worker_id") @db.Uuid
  rating     Int // CHECK BETWEEN 1 AND 5
  tags       ReviewTag[]
  tipAmount  Int         @default(0) @map("tip_amount") // recorded intent; paid off-platform (OPEN Q-8)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  job      Job             @relation(fields: [jobId], references: [id])
  customer CustomerProfile @relation(fields: [customerId], references: [userId])
  worker   WorkerProfile   @relation(fields: [workerId], references: [userId])

  @@index([workerId, createdAt])
  @@map("reviews")
}

model SosAlert {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  jobId     String?   @map("job_id") @db.Uuid
  lat       Float?
  lng       Float?
  status    SosStatus @default(OPEN)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  // Delivery to the safety desk. The alert row is written first; these columns record whether the desk got it.
  payload           Json? // exactly what the desk is sent (contains names, phones and the address: removed when the person is deleted); null on rows from before this column
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz(3) // null = the desk has not confirmed receipt yet
  deliveryAttempts  Int       @default(0) @map("delivery_attempts") // CHECK >= 0
  lastAttemptAt     DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastDeliveryError String?   @map("last_delivery_error") @db.VarChar(200)
  // A human took it on (acknowledged) and closed it (resolved). Who is kept; the admin account may be removed later.
  acknowledgedAt    DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedById  String?   @map("acknowledged_by") @db.Uuid
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedById      String?   @map("resolved_by") @db.Uuid

  user           User  @relation("SosRaiser", fields: [userId], references: [id])
  job            Job?  @relation(fields: [jobId], references: [id])
  acknowledgedBy User? @relation("SosAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy     User? @relation("SosResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  // Hand-written in the account_deletion_and_sos_delivery migration (Prisma cannot express them), keep them there:
  //  - sos_alerts_delivery_attempts_nonneg: CHECK (delivery_attempts >= 0)
  //  - sos_alerts_undelivered_idx: (created_at) WHERE delivered_at IS NULL AND payload IS NOT NULL (the retry sweep)
  @@index([status, createdAt])
  @@map("sos_alerts")
}
