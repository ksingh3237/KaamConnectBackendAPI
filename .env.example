# Copy to .env (git-ignored) and fill in. Never commit real values.
NODE_ENV=development
PORT=3000

# Existing local PostgreSQL (D-1). Use the EXACT case of the database name as created in pgAdmin.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/KaamConnect?schema=public
# Used only by automated tests. The database name MUST end in _test.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/KaamConnect_test?schema=public

# --- Authentication (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
JWT_ACCESS_SECRET=                # >= 32 chars, secret, different from OTP_PEPPER
OTP_PEPPER=                       # >= 32 chars, secret; HMAC key for OTP hashes
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
OTP_TTL_SEC=300
OTP_RESEND_SEC=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
TRUST_PROXY=0                     # number of reverse proxies in front (AWS ALB = 1); 0 = none

# --- Firebase phone sign-in (the app proves the phone number with Firebase; docs/13-firebase-phone-auth.md) ---
FIREBASE_AUTH_ENABLED=false       # true = POST /auth/firebase/verify is live; requires exactly one credentials source below
# Service-account JSON from Firebase console > Project settings > Service accounts. BACKEND-ONLY SECRET:
# keep the file OUTSIDE this repository (e.g. a sibling folder), never commit it, never ship it in the app.
FIREBASE_SERVICE_ACCOUNT_PATH=    # absolute path to that file, for a developer machine or a server with a mounted secret
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=  # the same JSON, base64-encoded, for hosts that only offer environment secrets
FIREBASE_AUTH_MAX_AGE_SEC=300     # how recently the person must have verified the phone (30-900); older tokens are refused
# false = the original SMS-code login (/auth/otp/*) and the "code" form of account deletion answer 404. This is the
# production setting once Firebase is the login (it also means no SMS provider/MSG91 is needed). Default true.
LEGACY_OTP_ENABLED=true

# --- File storage ---
STORAGE_PROVIDER=local            # local = files in .local-storage/ (dev only, refused in production) | s3
STORAGE_LOCAL_DIR=
PUBLIC_BASE_URL=                  # origin clients use, e.g. https://api.example.com (default http://localhost:PORT)
STORAGE_REGION=                   # s3 only, e.g. ap-south-1
STORAGE_BUCKET=                   # s3 only: ordinary media
STORAGE_BUCKET_PRIVATE=           # s3 only: Aadhaar images; must be a different bucket
STORAGE_ENDPOINT=                 # only for MinIO / LocalStack
STORAGE_ACCESS_KEY=               # leave empty on AWS to use the IAM role
STORAGE_SECRET_KEY=

# --- Dev-only switches: the app refuses to boot with these in production ---
OTP_DEV_BYPASS=false
SMS_PROVIDER=console              # console (logs OTP) | msg91 (later)
WORKER_VERIFICATION_MODE=auto     # auto = simulated approval (dev) | manual = admin review (production)

# --- Business configuration ---
JOB_OPEN_TTL_HOURS=24
DIRECT_ACCEPT_TTL_MIN=10
AVG_SPEED_KMH=20
COMMISSION_BENCHMARK_RATE=0.20    # competitor commission used for "Total saved"; KaamConnect itself charges 0%

# --- Rate limiting ---
# Requests one signed-in user may make per minute across all routes (on top of the per-IP limits). Default 240.
USER_RATE_LIMIT_PER_MIN=

# --- Safety ---
SOS_WEBHOOK_URL=                 # where SOS alerts are POSTed as JSON; REQUIRED (https) in production, empty = log only

# --- Scheduling and availability (all optional; these are the defaults) ---
BOOKING_DEFAULT_DURATION_MIN=90   # length of a booking window when the customer does not say
BOOKING_BUFFER_MIN=15             # smallest gap between two bookings of one worker
BOOKING_DEFAULT_TRAVEL_MIN=30     # gap assumed when a place has no coordinates
SCHEDULE_MIN_LEAD_MIN=30          # a requested appointment must be at least this far ahead
SCHEDULE_MAX_DAYS=30              # ...and at most this many days ahead
SCHEDULED_JOB_OPEN_TTL_HOURS=72   # how long a scheduled request keeps collecting quotes

# --- Optional ---
REDIS_URL=                        # empty = in-memory (D-6)

# Seed: also load the 6 areas that exist only in the legacy web prototype (Q-11)
SEED_LEGACY_AREAS=false

# Browser origins allowed to open a WebSocket (comma separated, e.g. http://localhost:8081). Native apps need nothing.
REALTIME_CORS_ORIGINS=

# Browser origins allowed to call the HTTP API (comma separated, exact origins, no wildcards), e.g. the Expo web dev server.
# Empty = none (native apps need nothing). npm run dev:local sets the local Expo ports for you.
CORS_ORIGINS=

# Account deletion ledger: one JSON line (user id + time, no personal data) per deleted account, appended to this file.
# Keep it OUTSIDE the database and with the backups so a restore can re-apply deletions (docs/08 section 1.5).
# Empty = written to the application log only (fine for local development).
DELETION_LEDGER_FILE=
